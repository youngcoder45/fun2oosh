# -- Fun2Oosh Economy Bot configuration ---------------------------------
# Copy this file to `.env` and fill in your values.

# REQUIRED: Discord bot token
# Get one at https://discord.com/developers/applications
DISCORD_TOKEN=your_token_here

# Your Discord user ID - unlocks admin commands (add_money, reset_economy)
# OWNER_ID=123456789012345678

# Optional: restrict the bot to a single guild (faster command sync)
# GUILD_ID=

# Optional: database location (defaults to the shipped fun2oosh.db)
# DATABASE_URL=sqlite+aiosqlite:///fun2oosh.db

# Command prefix for text commands (slash commands also available)
# COMMAND_PREFIX=!

# Economy tuning (optional overrides)
# MIN_BET=10
# MAX_BET=0  # 0 = no upper limit on a single bet (unlimited)
# DAILY_WAGER_LIMIT=50000
# WORK_REWARD=100
# DAILY_REWARD=500
# WEEKLY_REWARD=2000
